# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env

# --- Required ---------------------------------------------------------------

# Anthropic API key. Required when LLM_PROVIDER=claude (the default).
ANTHROPIC_API_KEY=

# --- LLM ---------------------------------------------------------------------

# Which provider to use: claude | azure
LLM_PROVIDER=claude

# Max tokens per LLM call.
LLM_MAX_TOKENS=2048

# Generation temperature. Lower is more consistent, higher more varied.
LLM_TEMPERATURE=0.3

# --- Security ----------------------------------------------------------------

# Optional. When set, all endpoints except /api/health require this value in the
# X-API-Key request header. Leave blank to run with no auth (local dev only).
PROPOSAL_API_KEY=

# Comma-separated allowed origins. "*" allows any origin and disables
# credentialed CORS requests. Set real origins before exposing this publicly.
CORS_ORIGINS=*

# --- Limits ------------------------------------------------------------------

# Max size of a single uploaded PDF/DOCX, in MB.
MAX_UPLOAD_SIZE_MB=10

# Max RFP text length, in characters.
MAX_RFP_LENGTH=100000

# --- Storage -----------------------------------------------------------------

# Directory for uploaded proposals, cached analysis, and history. In Docker this
# is the mounted volume path; see the Dockerfile.
PROPOSAL_DATA_DIR=data

# --- Azure OpenAI (only needed when LLM_PROVIDER=azure) ----------------------

# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
