# LLM Provider: "claude" (default) or "azure"
LLM_PROVIDER=claude

# LLM settings
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# Anthropic (required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Azure OpenAI (required if LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# API authentication (optional, leave unset to disable)
PROPOSAL_API_KEY=your-secret-api-key

# CORS origins (comma-separated, default "*")
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Storage directory for uploaded proposals (optional)
PROPOSAL_STORE_DIR=data/proposals

# Max upload file size in MB (default 10)
MAX_UPLOAD_SIZE_MB=10
