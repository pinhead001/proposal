# LLM Provider: "claude" (default) or "azure"
LLM_PROVIDER=claude

# Anthropic (required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Azure OpenAI (required if LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Storage directory for uploaded proposals (optional)
PROPOSAL_STORE_DIR=data/proposals
